{
  "version": 1,
  "artifact_store": {
    "enabled": true,
    "root_directory": "/home/cmd_mcp/artifacts",
    "max_upload_bytes": 524288000,
    "max_chunk_bytes": 524288
  },
  "deploy_profiles": [
    {
      "id": "antd-pri-dev",
      "description": "Deploy an uploaded antd-pri-dev zip package to /var/www/html/admin.",
      "artifact_name_pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*\\.zip$",
      "deploy_command_id": "deploy_antd_pri_dev"
    }
  ],
  "commands": [
    {
      "id": "deploy_antd_pri_dev",
      "description": "Run the fixed antd-pri-dev deployment helper for a committed zip artifact.",
      "enabled": true,
      "risk_level": "high",
      "access": "state_changing",
      "executable": "/opt/server-shell-mcp/scripts/deploy-antd-pri-dev.sh",
      "argv_template": [
        {
          "param": "artifact_path"
        }
      ],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {
        "artifact_path": {
          "type": "path",
          "required": true,
          "description": "Committed artifact path generated by the MCP artifact store.",
          "allowed_roots": [
            "/home/cmd_mcp/artifacts/committed"
          ],
          "mode": "read_only",
          "must_exist": true
        }
      },
      "execution": {
        "timeout_ms": 180000,
        "max_output_bytes": 16384,
        "per_command_limit": 1,
        "global_limit": 1
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.deploy_antd_pri_dev",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    }
  ]
}

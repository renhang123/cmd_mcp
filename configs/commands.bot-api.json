{
  "version": 1,
  "artifact_store": {
    "enabled": true,
    "root_directory": "/home/cmd_mcp/artifacts",
    "max_upload_bytes": 524288000,
    "max_chunk_bytes": 524288
  },
  "deploy_profiles": [
    {
      "id": "bot-api",
      "description": "Deploy an uploaded bot_api tar.gz package: replace /home/api/mixbot_api/App and restart the easyswoole server.",
      "artifact_name_pattern": "^.*bot_api.*\\.(tar\\.gz|tgz)$",
      "deploy_command_id": "deploy_bot_api"
    }
  ],
  "commands": [
    {
      "id": "deploy_bot_api",
      "description": "Run the fixed bot_api deployment helper for a committed tar.gz artifact.",
      "enabled": true,
      "risk_level": "high",
      "access": "state_changing",
      "executable": "/opt/server-shell-mcp/scripts/deploy-bot-api.sh",
      "argv_template": [
        {
          "param": "artifact_path"
        }
      ],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {
        "artifact_path": {
          "type": "path",
          "required": true,
          "description": "Committed bot_api artifact path generated by the MCP artifact store.",
          "allowed_roots": [
            "/home/cmd_mcp/artifacts/committed"
          ],
          "mode": "read_only",
          "must_exist": true
        }
      },
      "execution": {
        "timeout_ms": 180000,
        "max_output_bytes": 16384,
        "per_command_limit": 1,
        "global_limit": 1
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.deploy_bot_api",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    },
    {
      "id": "read_bot_api_logs",
      "description": "List bot_api log files under /home/api/mixbot_api/Log or read the tail of one log file for troubleshooting. Arguments: action (required, 'list' shows files with mtime and size, newest first; 'tail' reads one file); file (path under /home/api/mixbot_api/Log, used by tail only, defaults to the logs root which list ignores); lines (integer 1-2000, tail only, default 200); keywords (array of 1-5 plain strings, tail only, case-insensitive OR filter, e.g. [\"error\", \"timeout\"]).",
      "enabled": true,
      "risk_level": "low",
      "access": "read_only",
      "executable": "/opt/server-shell-mcp/scripts/read-bot-api-log.sh",
      "argv_template": [
        {"param": "action"},
        {"param": "file"},
        {"param": "lines"},
        {"repeat": {"param": "keywords", "prefix": "-e"}}
      ],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {
        "action": {
          "type": "enum",
          "required": true,
          "values": ["list", "tail"],
          "description": "list = show available log files; tail = read the last lines of one log file."
        },
        "file": {
          "type": "path",
          "required": false,
          "default": "/home/api/mixbot_api/Log",
          "description": "Log file to read (tail only). Must stay under /home/api/mixbot_api/Log.",
          "allowed_roots": [
            "/home/api/mixbot_api/Log"
          ],
          "mode": "read_only"
        },
        "lines": {
          "type": "int",
          "required": false,
          "default": 200,
          "min": 1,
          "max": 2000,
          "description": "Number of trailing lines to read (tail only)."
        },
        "keywords": {
          "type": "array",
          "required": false,
          "description": "Case-insensitive fixed-string keywords to keep, OR-combined (tail only).",
          "item": {
            "type": "string",
            "min_length": 1,
            "max_length": 128,
            "pattern": "^[A-Za-z0-9 _.,:@/()\\[\\]'\"*+?^~!=%-]+$"
          },
          "max_items": 5
        }
      },
      "execution": {
        "timeout_ms": 10000,
        "max_output_bytes": 32768,
        "per_command_limit": 2,
        "global_limit": 4
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.read_bot_api_logs",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    }
  ]
}

{
  "version": 1,
  "artifact_store": {
    "enabled": true,
    "root_directory": "/home/cmd_mcp/artifacts",
    "max_upload_bytes": 524288000,
    "max_chunk_bytes": 524288
  },
  "deploy_profiles": [
    {
      "id": "mixchat",
      "description": "Deploy an uploaded mixchat app or h5 tar.gz package to /var/www/html/mixchat.",
      "artifact_name_pattern": "^mixchat-[a-zA-Z0-9][a-zA-Z0-9._-]*\\.(tar\\.gz|tgz)$",
      "deploy_command_id": "deploy_mixchat"
    }
  ],
  "commands": [
    {
      "id": "deploy_mixchat",
      "description": "Run the fixed mixchat deployment helper for a committed tar.gz artifact.",
      "enabled": true,
      "risk_level": "high",
      "access": "state_changing",
      "executable": "/opt/server-shell-mcp/scripts/deploy-mixchat.sh",
      "argv_template": [
        {
          "param": "artifact_path"
        }
      ],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {
        "artifact_path": {
          "type": "path",
          "required": true,
          "description": "Committed mixchat app or h5 artifact path generated by the MCP artifact store.",
          "allowed_roots": [
            "/home/cmd_mcp/artifacts/committed"
          ],
          "mode": "read_only",
          "must_exist": true
        }
      },
      "execution": {
        "timeout_ms": 180000,
        "max_output_bytes": 16384,
        "per_command_limit": 1,
        "global_limit": 1
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.deploy_mixchat",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    }
  ]
}

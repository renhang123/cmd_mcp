      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {},
      "execution": {
        "timeout_ms": 3000,
        "max_output_bytes": 8192,
        "per_command_limit": 1,
        "global_limit": 1

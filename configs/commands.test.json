{
  "version": 1,
  "artifact_store": {
    "enabled": true,
    "root_directory": "/home/cmd_mcp/artifacts",
    "max_upload_bytes": 104857600,
    "max_chunk_bytes": 65536
  },
  "deploy_profiles": [
    {
      "id": "server-shell-mcp-test",
      "description": "Deploy an uploaded server-shell-mcp package on the test server.",
      "artifact_name_pattern": "^server-shell-mcp-[a-zA-Z0-9._-]+-linux-[a-z0-9]+\\.tar\\.gz$",
      "deploy_command_id": "deploy_uploaded_server_shell_mcp_test"
    }
  ],
  "commands": [
    {
      "id": "write_hello_test_file",
      "description": "Run the fixed test.sh script to write hello to test.txt.",
      "enabled": true,
      "risk_level": "medium",
      "access": "state_changing",
      "executable": "/home/cmd_mcp/test.sh",
      "argv_template": [],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {},
      "execution": {
        "timeout_ms": 3000,
        "max_output_bytes": 8192,
        "per_command_limit": 1,
        "global_limit": 1
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.write_hello_test_file",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    },
    {
      "id": "deploy_uploaded_server_shell_mcp_test",
      "description": "Run the fixed test deployment helper for a committed server-shell-mcp artifact.",
      "enabled": true,
      "risk_level": "high",
      "access": "state_changing",
      "executable": "/home/cmd_mcp/deploy-server-shell-mcp-test.sh",
      "argv_template": [
        {
          "param": "artifact_path"
        }
      ],
      "working_directory": "/home/cmd_mcp",
      "environment": {
        "mode": "minimal",
        "variables": {
          "LANG": "C"
        }
      },
      "parameters": {
        "artifact_path": {
          "type": "path",
          "required": true,
          "description": "Committed artifact path generated by the MCP artifact store.",
          "allowed_roots": [
            "/home/cmd_mcp/artifacts/committed"
          ],
          "mode": "read_only"
        }
      },
      "execution": {
        "timeout_ms": 60000,
        "max_output_bytes": 16384,
        "per_command_limit": 1,
        "global_limit": 1
      },
      "output": {
        "stdout": "text",
        "stderr": "text",
        "truncate": true
      },
      "audit": {
        "event_name": "command.deploy_uploaded_server_shell_mcp_test",
        "redact_parameters": [],
        "include_stdout": false,
        "include_stderr": false,
        "include_rejection": true
      }
    }
  ]
}
